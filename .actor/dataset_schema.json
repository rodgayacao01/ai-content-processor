        "properties": {
            "task": {
                "type": "string",
                "description": "The type of task performed (e.g., summarization, translation)."
            },
            "result": {
                "description": "The result of the processing. Can be a string or an object depending on the task.",
                "anyOf": [
                    { "type": "string" },
                    { "type": "object" }
                ]
            },
            "processing_time_ms": {
                "type": "number",
                "description": "Time taken to process the task in milliseconds."
            },
            "status": {
                "type": "string",
