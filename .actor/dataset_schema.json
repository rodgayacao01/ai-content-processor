            "display": {
                "component": "table",
                "properties": {
                    "task": { "label": "Task" },
                    "status": { "label": "Status" },
                    "processing_time_ms": { "label": "Time (ms)" },
                    "error": { "label": "Error" }
                }
            }
        }
    }
